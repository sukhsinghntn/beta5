@page "/forms/{FormId:int}/responses"
@using System.Net.Http.Json
@using System.Net
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using DynamicFormsApp.Shared.Models
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CookieHelper CookieHelper
@inject IJSRuntime JS
@inject DialogService DialogService
@implements IAsyncDisposable

<div class="container mt-4">
    <h2 class="mb-4">📄 Responses: <span class="text-primary">@form?.Name</span></h2>
    <p class="text-muted">@form?.Description</p>
    @if (unavailableInfo != null)
    {
        <FormUnavailableDisplay Info="@unavailableInfo" />
    }
    else if (!string.IsNullOrEmpty(deletedMessage))
    {
        <div class="alert alert-warning">@deletedMessage</div>
    }

    @if (form == null || responses == null)
    {
        <div class="alert alert-info">Loading responses...</div>
    }
    else if (!responses.Any())
    {
        <div class="alert alert-warning">No responses yet.</div>
    }
    else
    {
        <div class="mb-3">
            <button class="btn btn-outline-info me-2" @onclick="DownloadCsv">Download CSV</button>
            <button class="btn btn-outline-info" @onclick="DownloadPdf">Download PDF</button>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-auto">
                <input class="form-control form-control-sm" placeholder="Response ID" @bind="responseIdFilter" />
            </div>
            <div class="col-auto">
                <input class="form-control form-control-sm" placeholder="Submitted By" @bind="submitFilter" />
            </div>
            <div class="col-auto">
                <select class="form-select form-select-sm" @bind="statusFilter">
                    <option value="">All Statuses</option>
                    @foreach (var opt in statusOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table id="responsesTable" class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th scope="col">@(col switch { "ResponderName" => "Submitted By", "CreatedAt" => "Submitted At", _ => col })</th>
                        }
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredResponses)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                <td>
                                    @if (col == "CreatedAt")
                                    {
                                        <div>@FormatDateTime(row[col]?.ToString())</div>
                                    }
                                    else if (col == "Status")
                                    {
                                        <select class="form-select form-select-sm" value="@GetRowStatus(row)" @onchange="e => ChangeStatus(row, e)">
                                            <option value="">No Label</option>
                                            @foreach (var opt in statusOptions)
                                            {
                                                <option value="@opt">@statusIcons.GetValueOrDefault(opt, "🏷️") @opt</option>
                                            }
                                            <option value="__custom">+ Add label...</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <div>@row[col]</div>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@($"/forms/{FormId}/responses/{row["ResponseId"]}")">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public int FormId { get; set; }

    private Form form;
    private List<Dictionary<string, object>> responses;
    private string[] columns = Array.Empty<string>();
    private IJSObjectReference? exportModule;
    private string? deletedMessage;
    private DeletedFormInfo? unavailableInfo;
    private string responseIdFilter = string.Empty;
    private string submitFilter = string.Empty;
    private string statusFilter = string.Empty;
    private List<string> statusOptions = new() { "Approved", "Pending", "Rejected" };
    private Dictionary<string, string> statusIcons = new()
    {
        ["Approved"] = "✅",
        ["Pending"] = "⏳",
        ["Rejected"] = "❌"
    };
    private List<string> iconChoices = new() { "🏷️", "✅", "⏳", "❌", "⭐", "⚠️", "📌" };
    private IEnumerable<Dictionary<string, object>> FilteredResponses =>
        responses.Where(row =>
            (string.IsNullOrWhiteSpace(responseIdFilter) || row["ResponseId"].ToString().Contains(responseIdFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(submitFilter) || (row.TryGetValue("ResponderName", out var rn) && rn?.ToString()?.Contains(submitFilter, StringComparison.OrdinalIgnoreCase) == true)) &&
            (string.IsNullOrWhiteSpace(statusFilter) || (row.TryGetValue("Status", out var st) && string.Equals(st?.ToString(), statusFilter, StringComparison.OrdinalIgnoreCase))));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = await CookieHelper.LoginStatus();
            if (string.IsNullOrEmpty(user))
            {
                var ret = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
                Navigation.NavigateTo($"login?returnUrl={ret}", true);
                return;
            }

            var respForm = await Http.GetAsync($"api/forms/{FormId}");
            if (!respForm.IsSuccessStatusCode)
            {
                if (respForm.StatusCode == HttpStatusCode.Gone)
                {
                    unavailableInfo = await respForm.Content.ReadFromJsonAsync<DeletedFormInfo>();
                }
                else
                {
                    deletedMessage = "Form not found.";
                }
                StateHasChanged();
                return;
            }

            form = await respForm.Content.ReadFromJsonAsync<Form>();
            var respData = await Http.GetAsync($"api/forms/{FormId}/responses");
            if (!respData.IsSuccessStatusCode)
            {
                deletedMessage = "Unable to load responses.";
                StateHasChanged();
                return;
            }
            responses = await respData.Content.ReadFromJsonAsync<List<Dictionary<string, object>>>();

            columns = new[] { "ResponseId", "CreatedAt", "Status" };
            if (form.RequireLogin)
            {
                columns = columns.Concat(new[] { "ResponderName" }).ToArray();
            }

            statusOptions = statusOptions
                .Concat(responses.Select(r => r.TryGetValue("Status", out var st) ? st?.ToString() ?? string.Empty : string.Empty))
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();

            var savedIcons = await JS.InvokeAsync<string>("localStorage.getItem", $"form_{FormId}_statusIcons");
            if (!string.IsNullOrWhiteSpace(savedIcons))
            {
                var stored = JsonSerializer.Deserialize<Dictionary<string, string>>(savedIcons) ?? new();
                foreach (var kv in stored)
                {
                    statusIcons[kv.Key] = kv.Value;
                    if (!statusOptions.Contains(kv.Key)) statusOptions.Add(kv.Key);
                }
                statusOptions = statusOptions.OrderBy(s => s).ToList();
            }

            exportModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/exportHelper.js");
            StateHasChanged();
        }
    }

    private string FormatDateTime(string? val)
    {
        if (DateTime.TryParse(val, out var dt))
            return dt.ToString("MM/dd/yyyy h:mm tt");
        return val ?? string.Empty;
    }

    private async Task DownloadCsv()
    {
        if (exportModule is not null)
        {
            await exportModule.InvokeVoidAsync("downloadTableCsv", "responsesTable", $"{form?.Name ?? "responses"}.csv");
        }
        else
        {
            await JS.InvokeVoidAsync("downloadTableCsv", "responsesTable", $"{form?.Name ?? "responses"}.csv");
        }
    }

    private async Task DownloadPdf()
    {
        if (exportModule is not null)
        {
            await exportModule.InvokeVoidAsync("exportTableToPdf", "responsesTable", $"{form?.Name ?? "responses"}.pdf");
        }
        else
        {
            await JS.InvokeVoidAsync("exportTableToPdf", "responsesTable", $"{form?.Name ?? "responses"}.pdf");
        }
    }

    private string GetRowStatus(Dictionary<string, object> row)
    {
        return row.TryGetValue("Status", out var st) ? st?.ToString() ?? string.Empty : string.Empty;
    }

    private async Task ChangeStatus(Dictionary<string, object> row, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        var responseId = GetResponseId(row["ResponseId"]);
        if (value == "__custom")
        {
            var result = await DialogService.OpenAsync<StatusLabelDialog>("Add Label", new Dictionary<string, object> { { "Icons", iconChoices } });
            if (result is StatusLabel custom && !string.IsNullOrWhiteSpace(custom.Label))
            {
                if (!statusOptions.Contains(custom.Label)) statusOptions.Add(custom.Label);
                statusIcons[custom.Label] = custom.Icon;
                await JS.InvokeVoidAsync("localStorage.setItem", $"form_{FormId}_statusIcons", JsonSerializer.Serialize(statusIcons));
                row["Status"] = custom.Label;
                await Http.PutAsJsonAsync($"api/forms/{FormId}/responses/{responseId}/status", new { Status = custom.Label });
                StateHasChanged();
            }
        }
        else
        {
            row["Status"] = value ?? string.Empty;
            await Http.PutAsJsonAsync($"api/forms/{FormId}/responses/{responseId}/status", new { Status = row["Status"].ToString() });
            StateHasChanged();
        }
    }

    private int GetResponseId(object idVal)
    {
        return idVal is JsonElement je && je.ValueKind == JsonValueKind.Number ? je.GetInt32() : Convert.ToInt32(idVal);
    }

    public async ValueTask DisposeAsync()
    {
        if (exportModule is not null)
        {
            await exportModule.DisposeAsync();
        }
    }
}

